# ─────────────────────────────────────────────────────────────
# Variáveis do chatbot (só o servidor lê — NÃO use prefixo VITE_)
# Local: copie este arquivo para .env.local e preencha.
# Produção: configure em Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# OBRIGATÓRIO. Crie uma key gratuita em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional. Modelo gratuito do OpenRouter (id com sufixo ":free").
# Lista atual: https://openrouter.ai/models?q=free
# Se vazio, o código usa "meta-llama/llama-3.3-70b-instruct:free".
OPENROUTER_MODEL=

# Opcional. Usados só para atribuição no ranking do OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Opcional. Trava /api/chat para só aceitar chamadas do seu domínio.
# Ex.: https://seu-dominio.com  — se vazio, aceita de qualquer origem.
ALLOWED_ORIGIN=
